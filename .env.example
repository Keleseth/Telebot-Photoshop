# ======== BOT SETTINGS ========
# Токен Telegram-бота, полученный у BotFather
BOT_TOKEN=1234567890:ABCDEF_example_token
# Хост Redis (по умолчанию сервис внутри docker-compose)
REDIS_HOST=redis
# Порт Redis (по умолчанию 6379)
REDIS_PORT=6379
# Telegram ID первого администратора (указать свой telegram_id для полного доступа)
BOT_FIRST_ADMIN=111111111
# Лимит на количество фото, которые может обработать один пользователь в день
PHOTO_LIMIT_PER_DAY=6
# Базовый URL API (используется ботом для запросов)
API_BASE_URL=http://api:8000/api/v1


# ======== API SETTINGS ========
# Заголовок приложения FastAPI
APP_TITLE=TelebotPhotoshop
# Описание API (отображается в Swagger)
DESCRIPTION="Photo Processing API"

# ======== SECURITY (API secrets) ========
# Секретный ключ приложения (для подписи токенов, сессий и пр.)
SECRET=supersecretkey_example
# Секрет для механизма сброса пароля
RESET_PASSWORD_SECRET=reset_secret_example
# Секрет для верификации пользователей/операций
VERIFICATION_SECRET=verify_secret_example

# ======== LOGGING ========
# Уровень логирования (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=DEBUG

